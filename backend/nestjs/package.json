    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "smol-toml": "^1.4.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.12.2",
    "tsx": "^4.20.5",
    "typescript": "^6.0.2"
  }
}
