# ---------------------------------------------------------------------------
# yaemipaste environment configuration
# Copy this file to `.env` before running docker compose or install.sh:
#   cp .env.example .env
# ---------------------------------------------------------------------------

# [Deployment topology]
# same = one public host proxies the bundled UI and API together.
# split = UI and API use separate public origins behind your own Caddy/Nginx.
DEPLOYMENT_MODE=same
# For split mode, run either ui or api on each host. Leave empty for same mode.
SPLIT_ROLE=
# Compose profiles to start. Same-host uses ui,api; split hosts use one role.
COMPOSE_PROFILES=ui,api
# Pull prebuilt UI and API images by default. Set to build only when changing
# compile-time VITE_* settings or using a split deployment.
DEPLOYMENT_IMAGE_MODE=pull
# Pin this to an immutable release tag for production.
YAEMIPASTE_IMAGE_TAG=
# Optional registry overrides for self-hosted image mirrors.
YAEMIPASTE_UI_IMAGE=ghcr.io/emiliauh/yaemipaste-ui
YAEMIPASTE_API_IMAGE=ghcr.io/emiliauh/yaemipaste-api

# [UI build -> API routes]
# These are baked into locally built UI images. The prebuilt image supports the
# stock same-host values below; set DEPLOYMENT_IMAGE_MODE=build to customize.
# Leave these as `/api` and `/auth` for same-host deployments.
VITE_PASTE_API=/api
VITE_AUTH_API=/auth
# Optional explicit public site origin for generated preview/share links.
# Example: https://paste.example.com
# SECURITY: set only to your trusted public frontend origin.
VITE_PUBLIC_SITE_ORIGIN=
# Optional history websocket endpoint override (e.g. wss://paste.example.com/ws/history).
VITE_HISTORY_WS=
# Public resolver path for extension-free file links.
# Recommended public setup: expose the NestJS backend endpoint at /api/resolve.
# For the legacy Node compatibility resolver, set this to /resolve and enable RESOLVER_ENABLED=1.
# Set empty to disable public/token resolution fallback (token links then require local cache only).
VITE_FILE_RESOLVE_BASE=/api/resolve
# Optional token-owner lookup endpoint used before upload to set uploader metadata for token-auth sessions.
# Must return JSON { "username": "<name>" } when called with Authorization: <paste-token>.
# Set empty to disable this pre-upload owner hydration path.
VITE_TOKEN_OWNER_PATH=/api/token-owner

# Optional Cloudflare Turnstile site key for login hardening.
# Leave empty if you do not use Turnstile.
VITE_TURNSTILE_SITE_KEY=
# Optional: set to 1 to show ShareX download controls in the UI.
VITE_ENABLE_SHAREX=1
# Optional: set to 0 to disable account login/register flows and run public/anonymous UI mode.
VITE_ENABLE_AUTH=1
# Optional repository URL shown by the GitHub footer icon in the UI.
VITE_REPOSITORY_URL=https://github.com/emiliauh/yaemipaste

# Maximum file expiry in days shown in the UI dropdown.
# Default is 14 (two weeks). Set a higher/lower limit to match your policy.
# Examples: 7, 30, 90
VITE_MAX_EXPIRY_DAYS=14

# [Bundled NestJS backend runtime]
# Required public frontend origin. HTTPS with a DNS name is preferred; HTTP/IP
# origins are supported for direct or LAN deployments.
# Examples: https://paste.example.com, http://192.0.2.10:8080
PASTE_URL=

# [Integrated auth runtime]
# Path for the integrated auth DB inside the API container.
DB_PATH=/var/lib/yaemipaste-auth/users.db
# JWT signing secret for account sessions. Generate with: openssl rand -hex 32
# (exactly 64 lowercase hex characters; production rejects other formats).
# Do not start production Compose with this blank.
JWT_SECRET=
# Optional Turnstile secret for server-side captcha verification.
TURNSTILE_SECRET_KEY=
# Public API upload URL used in generated ShareX configs.
# Same host: https://paste.example.com/api
# Split host: https://api.example.com
PASTE_PUBLIC_API=

# [Passkey settings (NestJS backend)]
# Set to 1 to enable passkey registration/login endpoints, or 0 to disable.
PASSKEYS_ENABLED=0
# Display name shown by authenticators during passkey creation.
PASSKEY_RP_NAME=yaemipaste
# Optional RP ID override (defaults to hostname of first passkey origin).
PASSKEY_RP_ID=
# Optional comma-separated allowed origins for passkey ceremonies.
# Example: https://paste.example.com,http://localhost:5173
PASSKEY_ORIGINS=
# Keep these disabled unless you explicitly need their relaxed behavior.
PASSKEY_ALLOW_ANY_PORT=0
PASSKEY_ALLOW_SUBDOMAINS=0

# [Host exposure]
# Keep Compose loopback-bound behind Caddy or Nginx unless you intentionally
# expose it directly. Use 0.0.0.0 for direct IP access.
UI_BIND_ADDRESS=127.0.0.1
UI_PORT=8080
# Optional published API listener for a split API reverse proxy.
API_PUBLISH_BIND=127.0.0.1
API_PUBLISH_PORT=8000
# Exact comma-separated browser origins allowed to call a split API.
# Example: https://paste.example.com
CORS_ALLOWED_ORIGINS=
# Additional CSP origins permitted for browser API connections. 'self' is
# always included; add the exact API origin in split mode.
CSP_CONNECT_SRC=
# Set only when Turnstile is enabled: https://challenges.cloudflare.com
CSP_TURNSTILE_SRC=
# Internal upstream used by the UI container for API/auth/raw paths.
# Same host: http://paste-api:8000. Split UI host: https://api.example.com
API_UPSTREAM=http://paste-api:8000
# Number of reverse-proxy hops in front of the API. Keep 1 for the bundled UI
# proxy; set 0 when the API is reached directly without a trusted proxy.
TRUST_PROXY_HOPS=1
# Maximum in-flight multipart uploads accepted per trusted client IP.
MAX_CONCURRENT_UPLOADS_PER_CLIENT=4
# Remote URL uploads make outbound requests from the backend. Keep disabled
# unless you need them and have reviewed the SSRF risk for your network.
REMOTE_UPLOADS_ENABLED=0
# Require an account or upload token by default. Set to 1 only for a public
# anonymous upload endpoint.
ALLOW_ANONYMOUS_UPLOADS=0
# Total upload-directory quota enforced by the API. Use a byte value or a unit
# such as 10GiB. Set to 0 only when an external storage quota is enforced.
MAX_UPLOAD_DIR_SIZE=10GiB
# Resolver service toggle for docker-compose profile selection:
# 1 = start the legacy Node compatibility resolver
# 0 = use the recommended two-service deployment (frontend + NestJS backend only)
RESOLVER_ENABLED=0
RESOLVER_PORT=3101
RESOLVER_PUBLIC_ORIGIN=http://localhost:8080
RESOLVER_CACHE_TTL_MS=30000

# [Installer API integration]
# Optional override for privileged auth administration used by install.sh.
# By default the installer uses its local 127.0.0.1 listener rather than the
# public URL, which avoids WSL/Windows LAN-address NAT hairpin failures.
# Set only when the auth admin endpoint is intentionally on another host.
AUTH_ADMIN_BASE_URL=

# Relative endpoint paths used under AUTH_ADMIN_BASE_URL:
# First account bootstrap endpoint.
AUTH_BOOTSTRAP_PATH=/bootstrap
# Create token endpoint.
AUTH_TOKEN_CREATE_PATH=/tokens
# Revoke token endpoint (`%s` is replaced by URL-encoded token value).
AUTH_TOKEN_REVOKE_PATH=/tokens/%s
# Generate one-time admin claim token.
AUTH_ADMIN_CLAIM_INIT_PATH=/claim/init


# Public register endpoint used when creating first user with registration token.
AUTH_REGISTER_URL=

# Admin bearer token used by installer for bootstrap/token lifecycle actions.
# Generate with: openssl rand -hex 32 (exactly 64 lowercase hex characters).
# Keep it private. Never expose it to a browser.
AUTH_ADMIN_BEARER=
