# ---------------------------------------------------------------------------
# yaemipaste environment configuration
# Copy this file to `.env` before running docker compose or install.sh:
#   cp .env.example .env
# ---------------------------------------------------------------------------

# [UI runtime -> API routes]
# Leave these as `/api` and `/auth` when running behind the included compose setup.
VITE_PASTE_API=/api
VITE_AUTH_API=/auth

# Optional Cloudflare Turnstile site key for login hardening.
# Leave empty if you do not use Turnstile.
VITE_TURNSTILE_SITE_KEY=

# Maximum file expiry in days shown in the UI dropdown.
# Default is 14 (two weeks). Set a higher/lower limit to match your policy.
# Examples: 7, 30, 90
VITE_MAX_EXPIRY_DAYS=14

# [Container images]
# rustypaste backend image (file API + integrated auth API).
PASTE_API_IMAGE=orhunp/rustypaste:latest

# [Integrated auth runtime]
# Path for rustypaste integrated auth DB inside the container.
DB_PATH=/var/lib/rustypaste-auth/users.db
# JWT signing secret for account sessions (MUST be changed in production).
JWT_SECRET=change-me-in-production
# Optional Turnstile secret for server-side captcha verification.
TURNSTILE_SECRET_KEY=
# Optional explicit public API URL used inside generated ShareX configs.
# Example for public deployments: https://paste.example.com/api
PASTE_PUBLIC_API=http://localhost:8080/api

# [Passkey settings (Rust backend)]
# Set to 1 to enable passkey registration/login endpoints, or 0 to disable.
PASSKEYS_ENABLED=0
# Display name shown by authenticators during passkey creation.
PASSKEY_RP_NAME=yaemipaste
# Optional RP ID override (defaults to hostname of first passkey origin).
PASSKEY_RP_ID=
# Optional comma-separated allowed origins for passkey ceremonies.
# Example: https://paste.example.com,http://localhost:5173
PASSKEY_ORIGINS=

# [Host exposure]
# Port on your machine where the web UI is published.
# Example: UI_PORT=8080 => http://localhost:8080
UI_PORT=8080

# [Installer API integration]
# Base URL for privileged auth administration used by install.sh
# (bootstrap first user + token create/revoke actions).
AUTH_ADMIN_BASE_URL=http://localhost:8080/auth/admin

# Relative endpoint paths used under AUTH_ADMIN_BASE_URL:
# First account bootstrap endpoint.
AUTH_BOOTSTRAP_PATH=/bootstrap
# Create token endpoint.
AUTH_TOKEN_CREATE_PATH=/tokens
# Revoke token endpoint (`%s` is replaced by URL-encoded token value).
AUTH_TOKEN_REVOKE_PATH=/tokens/%s

# Public register endpoint used when creating first user with registration token.
AUTH_REGISTER_URL=http://localhost:8080/auth/register

# Admin bearer token used by installer for bootstrap/token lifecycle actions.
# Recommended: set a strong random value and keep it private.
AUTH_ADMIN_BEARER=
